{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wi-Fi Beacon Scanner 2",
  "version": "2.0.0-alpha.4",
  "identifier": "io.github.salilov95.wifibeaconscanner2",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "publisher": "salilov95",
    "copyright": "MIT License, salilov95",
    "category": "Utility",
    "shortDescription": "Wi-Fi beacon scanner and analyzer",
    "longDescription": "Scans Wi-Fi networks through the Windows Native Wifi API and decodes beacons: channels, security, 802.11 amendments, problems.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
